root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,props,csproj,slnx,xaml,manifest}]
indent_size = 2

[*.ps1]
end_of_line = crlf

[tests/**/*.cs]
# RF-17.2 requires Method_Condition_Result test names.
dotnet_diagnostic.CA1707.severity = none
