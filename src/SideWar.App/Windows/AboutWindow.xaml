<Window x:Class="SideWar.App.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sobre — SideWar" Width="520" Height="460" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
  <DockPanel Margin="12">
    <Button DockPanel.Dock="Bottom" Content="Fechar" Width="90" HorizontalAlignment="Right" Margin="0,12,0,0" IsDefault="True" IsCancel="True" Click="OnCloseClick" />
    <StackPanel>
      <TextBlock Text="SideWar" FontSize="20" FontWeight="Bold" />
      <TextBlock x:Name="VersionText" Margin="0,2,0,8" />
      <TextBlock x:Name="DataText" TextWrapping="Wrap" Margin="0,0,0,8" />
      <TextBlock x:Name="AssetsText" TextWrapping="Wrap" Margin="0,0,0,8" />
      <TextBlock Text="Licenças" FontWeight="Bold" />
      <TabControl x:Name="LicenseTabs" Height="240" />
    </StackPanel>
  </DockPanel>
</Window>
