<Window x:Class="SideWar.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações — SideWar" Width="520" Height="480" ShowInTaskbar="False"
        WindowStartupLocation="Manual" ResizeMode="NoResize" ShowActivated="False" FontSize="14">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <TextBlock x:Name="SaveErrorText" Foreground="{DynamicResource SettingsErrorBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
      <Button x:Name="SaveButton" Content="Salvar" Width="90" Margin="0,0,8,0" IsDefault="True" Click="OnSave" />
      <Button Content="Cancelar" Width="90" IsCancel="True" Click="OnCancel" />
    </StackPanel>
    <TabControl>
      <TabItem Header="Geral">
        <ScrollViewer x:Name="GeneralScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Focusable="True">
        <StackPanel Margin="12">
          <TextBlock Text="Modo de jogo (vale ao reiniciar o SideWar)" />
          <ComboBox x:Name="ModeCombo" Width="260" HorizontalAlignment="Left" Margin="0,2,0,8" />
          <CheckBox Content="Iniciar com o Windows" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,8" />
          <TextBlock Text="Ocultar em tela cheia" />
          <ComboBox x:Name="HideCombo" Width="220" HorizontalAlignment="Left" Margin="0,2,0,8" />
          <CheckBox Content="Usar UI Automation para a barra de tarefas" IsChecked="{Binding UseUia}" Margin="0,0,0,8" />
          <CheckBox Content="Auto-escala" IsChecked="{Binding AutoScale}" Margin="0,0,0,8" />
          <CheckBox Content="Pergunta-bônus entre as ondas (Tower Defense)" IsChecked="{Binding TdBonusQuestions}" Margin="0,0,0,4" />
          <CheckBox Content="Mostrar a renda de créditos (+X/s) abaixo do contador" IsChecked="{Binding TdShowIncome}" Margin="0,0,0,4" />
          <CheckBox Content="Modo discreto: sem brilhos nem contagem animada; +N só nos ganhos grandes" IsChecked="{Binding TdDiscreetMode}" Margin="0,0,0,4" />
          <CheckBox Content="Alertas: avisar quando a defesa estiver em risco" IsChecked="{Binding TdAlertsEnabled}" Margin="0,0,0,4" />
          <CheckBox Content="Pausar automaticamente antes de perder (você escolhe Salvar ou Deixar cair)" IsChecked="{Binding TdAlertsAutoPause}" Margin="0,0,0,4" />
          <CheckBox Content="Som curto ao aparecer um alerta" IsChecked="{Binding TdAlertsSound}" Margin="0,0,0,4" />
          <TextBlock Text="Alertas silenciados (desmarque para reativar)" Margin="0,4,0,2" />
          <ItemsControl ItemsSource="{Binding TdAlertMutes}" Margin="12,0,0,8">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox Content="{Binding Name}" IsChecked="{Binding Muted}" Margin="0,0,0,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <CheckBox Content="Ondas contínuas: corrida infinita, sem Preparo entre ondas (vale na próxima corrida)" IsChecked="{Binding TdContinuousWaves}" Margin="0,0,0,4" />
          <CheckBox Content="Painel de torres sempre aberto junto ao chip" IsChecked="{Binding TdTowerPanelPinned}" Margin="0,0,0,4" />
          <CheckBox Content="Iniciar as ondas automaticamente (Tower Defense)" IsChecked="{Binding TdAutoStart}" Margin="0,0,0,4" />
          <CheckBox Content="Recomecar automaticamente" IsChecked="{Binding TdAutoRestart}" Margin="0,0,0,4" />
          <TextBlock Text="Segundos de contagem do auto-início (5–60)" />
          <TextBox Text="{Binding TdAutoStartSeconds, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding TdAutoStart}" Width="80" HorizontalAlignment="Left" Margin="0,2,0,8" />
          <TextBlock Text="Tamanho da faixa Tower Defense (DIP, 32–96; aplica ao salvar, sem reiniciar)" />
          <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
            <Button Content="Pequeno (40)" Width="100" Margin="0,0,6,0" Click="OnBandSmall" />
            <Button Content="Médio (64)" Width="100" Margin="0,0,6,0" Click="OnBandMedium" />
            <Button Content="Grande (88)" Width="100" Click="OnBandLarge" />
          </StackPanel>
          <Slider Minimum="32" Maximum="96" Value="{Binding TdBandHeight}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,2,0,0" />
          <TextBlock Text="{Binding TdBandHeight}" Margin="0,0,0,8" />
          <TextBlock Text="Velocidade do jogo (Tower Defense)" />
          <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
            <Button Content="1x" Width="60" Margin="0,0,6,0" Click="OnSpeed1" />
            <Button Content="2x" Width="60" Margin="0,0,6,0" Click="OnSpeed2" />
            <Button Content="3x" Width="60" Margin="0,0,6,0" Click="OnSpeed3" />
            <TextBlock Text="{Binding TdGameSpeed, StringFormat={}{0}x}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock x:Name="PresenceText" TextWrapping="Wrap" Foreground="{DynamicResource SettingsMutedBrush}" />
        </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Aparência">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Focusable="True">
        <StackPanel Margin="12">
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SettingsMutedBrush}" Margin="0,0,0,8"
                     Text="No modo Tower Defense a faixa esmaece ao ativar outro app (opção abaixo, padrão 50%) e volta a 100% ao passar o mouse. As demais opções ficam desligadas por padrão." />
          <CheckBox Content="Esmaecer ao passar o mouse sobre a faixa" IsChecked="{Binding PeekOnHover}" Margin="0,0,0,4" />
          <TextBlock Text="Opacidade ao passar o mouse (0–255)" />
          <Slider Minimum="0" Maximum="255" Value="{Binding PeekOpacity}" IsEnabled="{Binding PeekOnHover}" Margin="0,2,0,0" />
          <TextBlock Text="{Binding PeekOpacity}" Margin="0,0,0,12" />
          <CheckBox Content="Esmaecer quando eu estiver ausente" IsChecked="{Binding FadeWhenAbsent}" Margin="0,0,0,4" />
          <TextBlock Text="Opacidade quando ausente (0–255)" />
          <Slider Minimum="0" Maximum="255" Value="{Binding AbsentOpacity}" IsEnabled="{Binding FadeWhenAbsent}" Margin="0,2,0,0" />
          <TextBlock Text="{Binding AbsentOpacity}" Margin="0,0,0,12" />
          <CheckBox Content="Esmaecer a faixa e o HUD ao usar outro app (Tower Defense)" IsChecked="{Binding TdFadeWhenUnfocused}" Margin="0,0,0,4" />
          <TextBlock Text="Opacidade ao usar outro app (10–90%)" />
          <Slider Minimum="10" Maximum="90" Value="{Binding TdFadePercent}" IsEnabled="{Binding TdFadeWhenUnfocused}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,2,0,0" />
          <TextBlock Text="{Binding TdFadePercent}" />
        </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Desempenho">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Focusable="True">
        <StackPanel Margin="12">
          <TextBlock Text="FPS presente" />
          <ComboBox x:Name="PresentCombo" Width="120" HorizontalAlignment="Left" Margin="0,2,0,8" />
          <TextBlock Text="FPS ausente" />
          <ComboBox x:Name="AbsentCombo" Width="120" HorizontalAlignment="Left" Margin="0,2,0,8" />
          <CheckBox Content="Economia na bateria" IsChecked="{Binding SaverOnBattery}" Margin="0,0,0,8" />
          <CheckBox Content="Forçar economia" IsChecked="{Binding ForceSaver}" />
        </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Atalhos">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Focusable="True">
        <StackPanel Margin="12">
          <TextBlock Text="Modo interativo da faixa" />
          <TextBox x:Name="HkInteractive" Margin="0,2,0,2" />
          <TextBlock x:Name="HkInteractiveErr" Foreground="{DynamicResource SettingsErrorBrush}" Margin="0,0,0,8" />
          <TextBlock Text="Visibilidade" />
          <TextBox x:Name="HkVisibility" Margin="0,2,0,2" />
          <TextBlock x:Name="HkVisibilityErr" Foreground="{DynamicResource SettingsErrorBrush}" Margin="0,0,0,8" />
          <TextBlock Text="Pausa" />
          <TextBox x:Name="HkPause" Margin="0,2,0,2" />
          <TextBlock x:Name="HkPauseErr" Foreground="{DynamicResource SettingsErrorBrush}" Margin="0,0,0,8" />
          <TextBlock Text="Iniciar onda (Tower Defense)" />
          <TextBox x:Name="HkStartWave" Margin="0,2,0,2" />
          <TextBlock x:Name="HkStartWaveErr" Foreground="{DynamicResource SettingsErrorBrush}" Margin="0,0,0,8" />
          <TextBlock x:Name="HkConflictText" Foreground="{DynamicResource SettingsErrorBrush}" />
          <Button Content="Restaurar padrão" HorizontalAlignment="Left" Click="OnRestoreHotkeys" Margin="0,8,0,0" />
        </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Acessibilidade">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Focusable="True">
        <StackPanel Margin="12">
          <CheckBox Content="Reduzir movimento" IsChecked="{Binding ReducedMotion}" />
        </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Diagnóstico">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Focusable="True">
        <StackPanel Margin="12">
          <CheckBox Content="Gravar comandos" IsChecked="{Binding RecordCommands}" Margin="0,0,0,8" />
          <TextBlock Text="Nível de log" />
          <ComboBox x:Name="LogCombo" Width="140" HorizontalAlignment="Left" Margin="0,2,0,0" />
        </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
